DB_HOST=mysql
DB_PORT=3306
DB_USER=opspilot
DB_PASSWORD=opspilot_secret
DB_NAME=opspilot

JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_ENV=development

# Get a free testing key from https://aistudio.google.com/app/apikey
# Leave empty to disable AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
# Gemini 3+ models support thinking levels: low or high.
GEMINI_THINKING_LEVEL=high
# Gemini 2.5 models use thinking budgets instead; -1 means dynamic thinking.
GEMINI_THINKING_BUDGET=-1
GEMINI_TIMEOUT_SECONDS=120
